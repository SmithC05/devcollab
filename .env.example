# ============================================================
# Engineering Decision Twin — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# Django
# -------
DJANGO_SECRET_KEY=change-me-use-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
# --------
# Leave unset (or blank) to use SQLite (default for local development).
# Set to a PostgreSQL URL for staging / production:
#   DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=

# Frontend
# --------
# The base URL the React app uses to reach the Django API.
# In development this is always the Django dev server.
VITE_API_BASE_URL=http://localhost:8000
